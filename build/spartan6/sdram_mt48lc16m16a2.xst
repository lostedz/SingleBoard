set -tmpdir "build/spartan6/tmp"
run
-ifn build/spartan6/sdram_mt48lc16m16a2.prj
-ifmt mixed
-ofn build/spartan6/sdram_mt48lc16m16a2.ngc
-ofmt NGC
-p xc6slx16-2-ftg256
-top sdram_mt48lc16m16a2
-opt_mode Speed
-opt_level 1
-uc build/spartan6/sdram_mt48lc16m16a2.xcf
-keep_hierarchy Yes
-read_cores Yes
-iobuf NO
-bufg 0
-ram_extract YES
-ram_style Block
-rom_extract YES
-rom_style Block
